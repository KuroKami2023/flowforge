# Supabase (public — safe for the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NVIDIA (SERVER ONLY — never prefix with VITE_, never expose to the browser)
NVIDIA_API_KEY=

# Supabase service-role key (SERVER ONLY — Vercel env vars, never commit)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: cron shared secret so /api/cron/* can reject unauthenticated callers
CRON_SECRET=

# Optional: per-IP rate limit tuning
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
